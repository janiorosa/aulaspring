
# ==========================================
# General
# ==========================================

HELP.md

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini
._*

# Logs and temporary files
*.log
logs/
*.tmp
*.swp
*.swo
*~

# ==========================================
# Java / Maven / Spring Boot
# ==========================================

# Maven build output, anywhere in the project
**/target/

# Compiled Java and packaged artifacts
*.class
*.jar
*.war
*.ear

# Keep Maven Wrapper scripts and configuration,
# but ignore its downloaded wrapper JAR
.mvn/wrapper/maven-wrapper.jar

# Spring Tool Suite / Eclipse
.apt_generated/
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache/

# ==========================================
# Java IDEs
# ==========================================

# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr

# NetBeans
/nbproject/private/
/nbbuild/
/nbdist/
/.nb-gradle/

# VS Code
.vscode/

# ==========================================
# Node.js / React / Vite
# ==========================================

# Dependencies, at any nesting level
**/node_modules/

# Generated frontend build output
**/dist/

# npm / Yarn / pnpm logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Package manager caches
.npm/
.yarn/cache/
.pnpm-store/

# ==========================================
# Environment variables and secrets
# ==========================================

# Ignore local environment files
.env
.env.*
**/.env
**/.env.*

# Allow safe example templates
!.env.example
!**/.env.example

# ==========================================
# Other build output
# ==========================================

**/build/
.gradle/
.gitignore.BKP
